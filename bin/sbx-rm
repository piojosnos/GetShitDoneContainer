#!/usr/bin/env bash
# ------------------------------------------------------------------------------
# Removes a sandbox's container; with --unregister also its registry entry
# ------------------------------------------------------------------------------
# Usage: sbx-rm NAME [--unregister] [--yes]
# Compose takes the container and its network, never volumes or images. Nothing
# in the sandbox folder is read, written or deleted. A running sandbox goes only
# after a y on the terminal, or with --yes. A broken entry has no folder for
# Compose, so with --unregister its container is stopped and removed by name.
# ------------------------------------------------------------------------------

# The library sets entryFile, entryDir and registryDir.
# shellcheck disable=SC2154
set -eu

. "$(dirname "$0")/sbx-lib.sh"

sandboxName=""
unregisterEntry=no
skipConfirmation=no
entryBroken=no
folderText=""
usageText='NAME [--unregister] [--yes]'

# ------------------------------------------------------------------------------
# parse_arguments ARG...: sets sandboxName, unregisterEntry and skipConfirmation
# ------------------------------------------------------------------------------
# --unregister and --yes may come before or after the name, once each. A second
# name, or anything else after the name, is the usage.
# ------------------------------------------------------------------------------
parse_arguments() {
  local argument

  if [ "$#" -lt 1 ] || [ "$#" -gt 3 ]; then
    sbx_usage "$usageText"
  fi

  for argument in "$@"; do
    case "$argument" in
      --unregister)
        if [ "$unregisterEntry" = "yes" ]; then
          sbx_usage "$usageText"
        fi

        unregisterEntry=yes
        ;;
      --yes)
        if [ "$skipConfirmation" = "yes" ]; then
          sbx_usage "$usageText"
        fi

        skipConfirmation=yes
        ;;
      *)
        if [ -n "$sandboxName" ]; then
          sbx_usage "$usageText"
        fi

        sandboxName=$argument
        ;;
    esac
  done

  if [ -z "$sandboxName" ]; then
    sbx_usage "$usageText"
  fi
}

# ------------------------------------------------------------------------------
# confirm_if_running NAME: a running sandbox goes only after a y or with --yes
# ------------------------------------------------------------------------------
# The question is read from stdin, and only when stdin is a terminal; a script
# without --yes is refused, so a pipe can never answer for the user. Anything
# but y or Y, an empty line included, keeps the sandbox.
# ------------------------------------------------------------------------------
confirm_if_running() {
  local answer=""

  if ! sandbox_is_running "$1"; then
    return 0
  fi

  warn_sessions_close "$1" "is running; removing it"

  if [ "$skipConfirmation" = "yes" ]; then
    return 0
  fi

  if [ ! -t 0 ]; then
    sbx_error "sbx-$1 is running and there is no terminal to confirm on; add --yes to remove it anyway. Nothing was changed"
    return 1
  fi

  read -r -p "Remove the running sbx-$1? [y/N] " answer || answer=""

  case "$answer" in
    y|Y)
      return 0
      ;;
  esac

  sbx_error "sbx-$1 was not removed; it still runs and nothing was changed"
  return 1
}

# ------------------------------------------------------------------------------
# read_entry NAME: reads the entry; one that exists but is unusable is broken
# ------------------------------------------------------------------------------
# Sets entryBroken and folderText, the folder named in the messages. A missing
# entry ends the script with the not-registered error.
# ------------------------------------------------------------------------------
read_entry() {
  if read_registry_entry "$1" 2>/dev/null; then
    entryBroken=no
    folderText=$entryDir
    return 0
  fi

  if [ ! -f "$entryFile" ]; then
    read_registry_entry "$1"
    return 1
  fi

  entryBroken=yes
  folderText="the sandbox folder"
}

# ------------------------------------------------------------------------------
# remove_container NAME: takes the container and its network of the sandbox
# ------------------------------------------------------------------------------
remove_container() {
  if ! run_compose "$1" down; then
    sbx_error "docker compose down failed for sbx-$1; the registry entry stays and nothing in $entryDir was changed"
    return 1
  fi
}

# ------------------------------------------------------------------------------
# remove_broken_sandbox NAME: the container sbx-NAME of a broken entry, by name
# ------------------------------------------------------------------------------
# Compose needs the folder the entry lacks, so plain docker stops and removes
# the one container with that exact name; volumes stay. Only with --unregister,
# because the entry goes too. Docker must answer, or a stopped Docker would
# read as no container and the entry would go while the container stays.
# ------------------------------------------------------------------------------
remove_broken_sandbox() {
  if [ "$unregisterEntry" != "yes" ]; then
    read_registry_entry "$1" || true
    sbx_error "the entry is broken, so sbx-$1 cannot be taken down with Compose; sbx-rm $1 --unregister removes the container by name and clears the entry"
    return 1
  fi

  require_docker || return 1

  if ! docker container inspect "sbx-$1" >/dev/null 2>&1 </dev/null; then
    return 0
  fi

  echo "sbx-rm: the entry $entryFile is broken; removing the container sbx-$1 by name"

  confirm_if_running "$1" || return 1

  if ! docker stop "sbx-$1" >/dev/null </dev/null; then
    sbx_error "docker stop failed for sbx-$1; the registry entry stays"
    return 1
  fi

  if ! docker rm "sbx-$1" >/dev/null </dev/null; then
    sbx_error "Docker could not remove the container sbx-$1; the registry entry stays"
    return 1
  fi
}

# ------------------------------------------------------------------------------
# unregister_sandbox NAME: deletes the registry entry, the only delete here
# ------------------------------------------------------------------------------
# Both the Compose path and the broken-entry path end here.
# ------------------------------------------------------------------------------
unregister_sandbox() {
  if ! rm -- "$entryFile"; then
    sbx_error "could not delete $entryFile; the container is gone and nothing in $folderText was changed"
    return 1
  fi

  if [ "$entryBroken" = "yes" ]; then
    echo "sbx-rm: deleted the registry entry $entryFile; sbx-add $1 HOST_PATH registers the sandbox again"
  else
    echo "sbx-rm: deleted the registry entry $entryFile; sbx-add $1 \"$entryDir\" registers the folder again"
  fi
}

# ------------------------------------------------------------------------------
# Main / Entry Point
# ------------------------------------------------------------------------------
parse_arguments "$@"
sbx_init
check_name "$sandboxName"
read_entry "$sandboxName"

if [ "$entryBroken" = "yes" ]; then
  remove_broken_sandbox "$sandboxName"
else
  confirm_if_running "$sandboxName"
  remove_container "$sandboxName"
fi

if [ "$unregisterEntry" = "yes" ]; then
  unregister_sandbox "$sandboxName"
fi

echo "sbx-rm: the container sbx-$sandboxName is gone; nothing in $folderText was changed"
