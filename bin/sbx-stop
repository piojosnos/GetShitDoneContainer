#!/usr/bin/env bash
# ------------------------------------------------------------------------------
# Stops a registered sandbox by name; the container and every file stay
# ------------------------------------------------------------------------------
# Usage: sbx-stop NAME
# Compose stop keeps the container, so the next sbx-start reuses it.
# ------------------------------------------------------------------------------

# The library sets entryDir.
# shellcheck disable=SC2154
set -eu

. "$(dirname "$0")/sbx-lib.sh"

# ------------------------------------------------------------------------------
# stop_sandbox NAME: stops the container of the sandbox
# ------------------------------------------------------------------------------
stop_sandbox() {
  if ! run_compose "$1" stop; then
    sbx_error "docker compose stop failed for sbx-$1"
    return 1
  fi
}

# ------------------------------------------------------------------------------
# Main / Entry Point
# ------------------------------------------------------------------------------
[ "$#" -eq 1 ] || sbx_usage 'NAME'
sbx_init
check_name "$1"
read_registry_entry "$1"
stop_sandbox "$1"
echo "sbx-stop: sbx-$1 is stopped; nothing in $entryDir was changed"
