#!/usr/bin/env bash
# ------------------------------------------------------------------------------
# Syncs the image's best-practices bundle into the Claude config at every start
# ------------------------------------------------------------------------------
# Other skills (GSD, your own) are never touched.
# ------------------------------------------------------------------------------
set -eu

bundleDir=${SBX_BUNDLE_DIR:-/opt/sbx/best-practices}
configDir=${CLAUDE_CONFIG_DIR:-}
skillList=$configDir/.best-practices-skills

# ------------------------------------------------------------------------------
# check_inputs: stops the start when the config folder or the bundle is missing
# ------------------------------------------------------------------------------
check_inputs() {
  if [ -z "$configDir" ]; then
    echo "[sbx] ERROR: CLAUDE_CONFIG_DIR is not set." >&2
    exit 1
  fi

  if [ ! -d "$bundleDir/rules" ]; then
    echo "[sbx] ERROR: the best-practices bundle is missing: $bundleDir/rules" >&2
    exit 1
  fi
}

# ------------------------------------------------------------------------------
# sync_rules: replaces rules/ with the image's rules
# ------------------------------------------------------------------------------
sync_rules() {
  rm -rf "$configDir/rules"
  cp -R "$bundleDir/rules" "$configDir/rules"
}

# ------------------------------------------------------------------------------
# remove_listed_skills: removes the skills the last sync listed
# ------------------------------------------------------------------------------
# So a skill dropped from the bundle goes away.
# ------------------------------------------------------------------------------
remove_listed_skills() {
  local oldName

  if [ ! -f "$skillList" ]; then
    return
  fi

  while IFS= read -r oldName; do
    case "$oldName" in
      ""|*/*|.*) continue ;;
    esac

    rm -rf "$configDir/skills/$oldName"
  done <"$skillList"
}

# ------------------------------------------------------------------------------
# copy_bundle_skills: copies the bundle's skills and lists their names
# ------------------------------------------------------------------------------
copy_bundle_skills() {
  local skillDir skillName

  : >"$skillList"

  for skillDir in "$bundleDir"/skills/*/; do
    if [ ! -d "$skillDir" ]; then
      continue
    fi

    skillDir=${skillDir%/}
    skillName=$(basename "$skillDir")
    echo "$skillName" >>"$skillList"
    rm -rf "$configDir/skills/$skillName"
    cp -R "$skillDir" "$configDir/skills/$skillName"
  done
}

# ------------------------------------------------------------------------------
# Main / Entry Point
# ------------------------------------------------------------------------------
check_inputs
mkdir -p "$configDir/skills"
sync_rules
remove_listed_skills
copy_bundle_skills
