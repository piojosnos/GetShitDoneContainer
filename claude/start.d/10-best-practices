#!/usr/bin/env bash
set -eu

# Syncs the image's best-practices bundle into the Claude config folder.
# - Runs at every container start, as sandbox, with no network.
# - rules/ is a full mirror: wiped, then copied fresh from the image.
# - skills/: the names listed last time in the list file are removed, then the bundle's
#   skills are copied and listed again. Other skills (GSD, your own) are never touched,
#   and a bundle skill wins a name clash.
# - Never touches CLAUDE.md, settings, the login or the memories under projects/.
# - SBX_BUNDLE_DIR exists so tests can point the script at a fixture bundle.

bundleDir=${SBX_BUNDLE_DIR:-/opt/sbx/best-practices}
configDir=${CLAUDE_CONFIG_DIR:-}

if [ -z "$configDir" ]; then
  echo "[sbx] ERROR: CLAUDE_CONFIG_DIR is not set." >&2
  exit 1
fi

skillList=$configDir/.best-practices-skills

if [ ! -d "$bundleDir/rules" ]; then
  echo "[sbx] ERROR: the best-practices bundle is missing: $bundleDir/rules" >&2
  exit 1
fi

mkdir -p "$configDir/skills"
rm -rf "$configDir/rules"
cp -R "$bundleDir/rules" "$configDir/rules"

if [ -f "$skillList" ]; then
  while IFS= read -r oldName; do
    case "$oldName" in
      ""|*/*|.*) continue ;;
    esac

    rm -rf "$configDir/skills/$oldName"
  done <"$skillList"
fi

: >"$skillList"

for skillDir in "$bundleDir"/skills/*/; do
  if [ ! -d "$skillDir" ]; then
    continue
  fi

  skillDir=${skillDir%/}
  skillName=$(basename "$skillDir")
  echo "$skillName" >>"$skillList"
  rm -rf "$configDir/skills/$skillName"
  cp -R "$skillDir" "$configDir/skills/$skillName"
done
