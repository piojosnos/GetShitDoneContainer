#!/usr/bin/env bash
# A fake GSD for the Linux self-tests. It is not GSD.
# - One script installed under two names, WORK/bin/gsd-core and WORK/bin/gsd-tools; the name it runs as picks its behavior.
# - gsd-core --claude --global --config-dir DIR: the installer. It models only what the checks read: gsd-core/VERSION,
#   one GSD skill, settings.json and a banner line.
# - gsd-tools runtime-identity --raw: prints the package identity line.
# - FAKE_REPO is the repository root; the pin comes from its versions.env. Without it the fake exits 2.
# - FAKE_GSD_LOG: when set, each call appends its name and arguments to that file.
# - FAKE_GSD_FAIL=1: the installer prints "fake gsd: install failed on purpose" to stderr and exits 1.
# - FAKE_GSD_VERSION: the version the installer writes to gsd-core/VERSION (default: the pin).
# - FAKE_GSD_IDENTITY: the version gsd-tools reports (default: the pin).
# - FAKE_GSD_CLASH=NAME: the installer also writes skills/NAME/SKILL.md as "fake GSD copy of NAME".
# - FAKE_GSD_DROPS_SETTINGS=1: the installer overwrites settings.json with {}.
# - Anything else exits 99 with "fake gsd: unhandled".
# - Linux only, in the dev sandbox.
set -u

toolName=$(basename "$0")

# --------------------------------------------------------------------------------
# pinned_version: prints GSD_CORE_VERSION from FAKE_REPO/versions.env.
# --------------------------------------------------------------------------------
pinned_version() {
  sed -n 's/^GSD_CORE_VERSION=//p' "$FAKE_REPO/versions.env" | head -n 1
}

# --------------------------------------------------------------------------------
# log_call ARGS...: appends the tool name and its arguments to FAKE_GSD_LOG when it is set.
# --------------------------------------------------------------------------------
log_call() {
  if [ -n "${FAKE_GSD_LOG:-}" ]; then
    echo "$toolName $*" >>"$FAKE_GSD_LOG"
  fi
}

# --------------------------------------------------------------------------------
# run_installer DIR: models gsd-core --claude --global --config-dir DIR.
# --------------------------------------------------------------------------------
run_installer() {
  local configDir=$1
  local version=${FAKE_GSD_VERSION:-$(pinned_version)}

  if [ "${FAKE_GSD_FAIL:-}" = 1 ]; then
    echo "fake gsd: install failed on purpose" >&2
    exit 1
  fi

  echo "GSD fake installer banner"

  mkdir -p "$configDir/gsd-core" "$configDir/skills/gsd-fake-skill" || exit 1
  printf '%s' "$version" >"$configDir/gsd-core/VERSION"
  echo "fake GSD skill" >"$configDir/skills/gsd-fake-skill/SKILL.md"

  if [ -n "${FAKE_GSD_CLASH:-}" ]; then
    mkdir -p "$configDir/skills/$FAKE_GSD_CLASH"
    echo "fake GSD copy of $FAKE_GSD_CLASH" >"$configDir/skills/$FAKE_GSD_CLASH/SKILL.md"
  fi

  if [ "${FAKE_GSD_DROPS_SETTINGS:-}" = 1 ]; then
    echo '{}' >"$configDir/settings.json"
  elif [ ! -f "$configDir/settings.json" ]; then
    echo '{"hooks":{}}' >"$configDir/settings.json"
  fi
}

# --------------------------------------------------------------------------------
# print_identity: models gsd-tools runtime-identity --raw.
# --------------------------------------------------------------------------------
print_identity() {
  local version=${FAKE_GSD_IDENTITY:-$(pinned_version)}

  printf '{"packageName":"@opengsd/gsd-core","version":"%s"}\n' "$version"
}

# --------------------------------------------------------------------------------
# Main / Entry Point
# --------------------------------------------------------------------------------
if [ -z "${FAKE_REPO:-}" ]; then
  echo "fake gsd: FAKE_REPO is not set" >&2
  exit 2
fi

log_call "$@"

if [ "$toolName" = gsd-core ] && [ "$#" -eq 4 ] && [ "$1" = --claude ] && [ "$2" = --global ] && [ "$3" = --config-dir ]; then
  run_installer "$4"
  exit 0
fi

if [ "$toolName" = gsd-tools ] && [ "$#" -eq 2 ] && [ "$1" = runtime-identity ] && [ "$2" = --raw ]; then
  print_identity
  exit 0
fi

echo "fake gsd: unhandled" >&2
exit 99
