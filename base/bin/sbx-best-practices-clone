#!/usr/bin/env bash
# --------------------------------------------------------------------------------
# Clones the best-practices repo into the sandbox and runs sbx-init to link it
# --------------------------------------------------------------------------------
# Usage: sbx-best-practices-clone (run sbx-gh-login first for a private repo)
# It never overwrites: an existing directory is refused and left as it is.
# --------------------------------------------------------------------------------
set -eu

: "${BEST_PRACTICES_REPO_URL:?BEST_PRACTICES_REPO_URL is not set}"
: "${SBX_BEST_PRACTICES_DIR:?SBX_BEST_PRACTICES_DIR is not set}"

# --------------------------------------------------------------------------------
# Main / Entry Point
# --------------------------------------------------------------------------------
if [ -e "$SBX_BEST_PRACTICES_DIR" ]; then
  echo "[sbx] ERROR: $SBX_BEST_PRACTICES_DIR already exists; nothing was changed." >&2
  echo "[sbx]        To update it: git -C $SBX_BEST_PRACTICES_DIR pull. To relink it: sbx-init" >&2
  exit 1
fi

if ! GIT_TERMINAL_PROMPT=0 git clone "$BEST_PRACTICES_REPO_URL" "$SBX_BEST_PRACTICES_DIR"; then
  echo "[sbx] ERROR: cannot clone $BEST_PRACTICES_REPO_URL. A private repo needs sbx-gh-login first." >&2
  exit 1
fi

exec sbx-init
