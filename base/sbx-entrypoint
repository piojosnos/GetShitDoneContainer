#!/usr/bin/env bash
set -eu

# Container start check, then run the command.
# - Runs only at container start, never in docker exec shells, so it sets no
#   environment (shells get everything from image ENV).
# - Refuses to start unless the workspace is a real, writable mount. Without it
#   (a plain docker run, a broken compose file), data would land in the container
#   layer and be lost on recreate.
# - Refuses to start unless the project and state folders exist. A mistyped
#   SBX_DIR has neither.
# - Creates the state subfolders that are missing. Installs nothing.
# - SBX_STATE_DIRS: extra state subfolders, set by the agent image (Claude adds
#   "claude"), so this base script never needs to know which agent is on top.
# - Then it runs the start hooks in /etc/sbx/start.d (agent images add theirs there).
#   Folders are skipped and the glob never matches dotfiles; anything else must be an
#   executable regular file. A link that points nowhere, a fifo or a socket stops the
#   start, as do a file that is not executable and a hook that fails.
# - The start steps run only when the file is executed, so a test can source it
#   and call the functions.

ws=/home/sandbox/workspace
state=$ws/state
hookDir=/etc/sbx/start.d

# --------------------------------------------------------------------------------
# is_mount PATH: true when PATH is a mount point.
# --------------------------------------------------------------------------------
# Field 5 of /proc/self/mountinfo is the mount point; no util-linux "mountpoint" needed.
is_mount() { awk -v p="$1" '$5==p { f=1 } END { exit !f }' /proc/self/mountinfo; }

# --------------------------------------------------------------------------------
# die MESSAGE: prints the error and how to start the sandbox, then stops the start.
# --------------------------------------------------------------------------------
die() {
  echo "[sbx] ERROR: $1" >&2
  echo "[sbx]        Start the sandbox with 'docker compose up' (see SANDBOX.md)." >&2
  exit 1
}

# --------------------------------------------------------------------------------
# Stops the start unless the workspace is a writable mount and SBX_NAME is set
# --------------------------------------------------------------------------------
check_workspace_mount() {
  is_mount "$ws" || die "$ws is not a bind mount; its data would be lost on recreate."
  [ -w "$ws" ] || die "$ws is not writable by $(id -un)."
  [ -n "${SBX_NAME:-}" ] || die "SBX_NAME is not set."
}

# --------------------------------------------------------------------------------
# Stops the start unless the project and state folders exist
# --------------------------------------------------------------------------------
check_project_and_state_folders() {
  [ -d "$ws/$SBX_NAME" ] || die "$ws/$SBX_NAME (the project folder) is missing."
  [ -d "$state" ] || die "$state is missing."
}

# --------------------------------------------------------------------------------
# Creates the state subfolders that are missing
# --------------------------------------------------------------------------------
create_state_dirs() {
  local stateFolder

  # ${SBX_STATE_DIRS:-} is unquoted on purpose: one word per folder name.
  for stateFolder in shell gh git ${SBX_STATE_DIRS:-}; do
    mkdir -p "$state/$stateFolder"
  done
}

# --------------------------------------------------------------------------------
# Runs every start hook in name order; any entry that is not an executable file stops the start
# --------------------------------------------------------------------------------
# The hooks run after the checks above and before the command. Names sort as text, so hooks
# use two-digit prefixes (10-, 20-). Folders are skipped; every other entry must be an
# executable regular file, so a dangling link, a fifo or a socket is refused, not skipped.
run_start_hooks() {
  local hook

  for hook in "$hookDir"/*; do
    # Only the unmatched glob of an empty folder is neither present nor a link.
    if [ ! -e "$hook" ] && [ ! -L "$hook" ]; then
      continue
    fi

    if [ -d "$hook" ]; then
      continue
    fi

    if [ ! -f "$hook" ]; then
      echo "[sbx] ERROR: start hook $hook is not a regular file; the container was not started." >&2
      exit 1
    fi

    if [ ! -x "$hook" ]; then
      echo "[sbx] ERROR: start hook $hook is not executable; the container was not started." >&2
      exit 1
    fi

    if ! "$hook"; then
      echo "[sbx] ERROR: start hook $hook failed; the container was not started." >&2
      exit 1
    fi
  done
}

# --------------------------------------------------------------------------------
# Main / Entry Point
# --------------------------------------------------------------------------------
# The steps run only when the file is executed; a test sources it to call the functions above.
if [ "${BASH_SOURCE[0]}" = "$0" ]; then
  check_workspace_mount
  check_project_and_state_folders
  create_state_dirs
  run_start_hooks
  exec "$@"
fi
