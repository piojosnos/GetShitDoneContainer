#!/usr/bin/env bash
# ------------------------------------------------------------------------------
# Container start: checks mount and folders, runs the hooks, then the command
# ------------------------------------------------------------------------------
# The steps live in sbx-start-lib.sh, next to this file; this file runs them.
# ------------------------------------------------------------------------------
set -eu

. "$(dirname "$0")/sbx-start-lib.sh"

# ------------------------------------------------------------------------------
# Main / Entry Point
# ------------------------------------------------------------------------------
check_workspace_mount || exit 1
check_sandbox_name || exit 1
check_project_and_state_folders || exit 1
create_state_dirs || exit 1
run_start_hooks || exit 1
enter_project_folder || exit 1
exec "$@"
