#!/usr/bin/env bash
set -eu

# Container start check, then run the command.
# - Runs only at container start, never in docker exec shells, so it sets no
#   environment (shells get everything from image ENV).
# - Refuses to start unless the workspace is a real, writable mount. Without it
#   (a plain docker run, a broken compose file), data would land in the container
#   layer and be lost on recreate.
# - Refuses to start unless the project and state folders exist. A mistyped
#   SBX_DIR has neither.
# - Creates the state subfolders that are missing. Installs nothing.
# - SBX_STATE_DIRS: extra state subfolders, set by the agent image (Claude adds
#   "claude"), so this base script never needs to know which agent is on top.
# - Then it runs the start hooks in /etc/sbx/start.d (agent images add theirs there).
#   Folders are skipped and the glob never matches dotfiles; anything else must be an
#   executable regular file. A link that points nowhere, a fifo or a socket stops the
#   start, as do a file that is not executable and a hook that fails.
# - Then changes to the project folder and runs the command there.
# - The steps live in sbx-start-lib.sh, next to this file; this file only runs them.

. "$(dirname "$0")/sbx-start-lib.sh"

# --------------------------------------------------------------------------------
# Main / Entry Point
# --------------------------------------------------------------------------------
check_workspace_mount || exit 1
check_project_and_state_folders || exit 1
create_state_dirs || exit 1
run_start_hooks || exit 1
enter_project_folder || exit 1
exec "$@"
