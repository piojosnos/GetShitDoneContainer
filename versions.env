# Every pinned version of the sbx images. This is the only place versions live.
# - build.sh reads this file with bash (source), so it is code: review it like a script.
# - One NAME=value per line, with no spaces, quotes or export.
# - NAME is uppercase letters and underscores. It ends in _VERSION (an exact x.y.z)
#   or _IMAGE (an image reference).
# - build.sh passes every NAME to both builds. Each Dockerfile uses only the ARGs it declares.
# - To bump: change the value, run ./build.sh, recreate the sandbox.
# - To add a tool: add one line here, and an ARG NAME right above the RUN that installs it.
# - Plain apt packages are not pinned here. They follow the pinned Ubuntu release.

# sbx-base
UBUNTU_IMAGE=ubuntu:24.04
NODE_VERSION=24.21.0
GH_VERSION=2.102.0

# sbx-claude
CLAUDE_CODE_VERSION=2.1.285
